# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE CONFIGURATION:
# Obtenha estas credenciais no painel do seu projeto Supabase (Project Settings -> API)
# SUPABASE_URL: URL do seu projeto (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY: Chave pública anônima para requisições seguras com RLS
SUPABASE_ANON_KEY=your-anon-key-here
